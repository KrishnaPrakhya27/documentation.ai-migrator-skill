# Copy to .env and fill in. Never commit real values.
FIRECRAWL_API_KEY=
DAI_API_KEY=
DAI_API_BASE=https://api.documentationai.app
MIGRATION_WORKSPACE_ROOT=
HTTP_PROXY=
HTTPS_PROXY=
MIGRATION_HEADERS_FILE=
MIGRATION_COOKIES_FILE=
MIGRATION_AUTH_ORIGINS=
MIGRATION_ASSET_PROVIDER=local
# --provider s3 stores assets in the Documentation.AI R2 media buckets, laid out as the media library stores them:
# org-<DAI_ORGANIZATION_ID>/doc-<DAI_DOCUMENTATION_ID>/<hash>-<name>.<ext>, images, videos and files (audio) each in their own bucket.
# Same variable names and values as the backend; each bucket is served from its CDN base, so URLs match the media library's.
# Images are required. Videos and files are optional (bucket and CDN base together): without them, those assets fail
# rather than land in the images bucket.
DAI_ORGANIZATION_ID=
DAI_DOCUMENTATION_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET_NAME=
R2_VIDEOS_BUCKET_NAME=
R2_FILES_BUCKET_NAME=
MEDIA_IMAGE_CDN_BASE=
MEDIA_VIDEO_CDN_BASE=
MEDIA_FILES_CDN_BASE=
MIGRATION_SEARCH_URL_TEMPLATE=
MIGRATION_TARGET_PUBLIC_BASE=
FIRECRAWL_PROXY_MODE=auto
FIRECRAWL_MAX_CONCURRENCY=
# 1 requests zero data retention from Firecrawl. Leave 0 unless the Firecrawl account has a ZDR
# agreement: without one Firecrawl rejects every scrape that asks for it. --zero-data-retention also enables it.
FIRECRAWL_ZERO_DATA_RETENTION=0
MIGRATION_DISCOVERY_LIMIT=5000
MIGRATION_ALLOWED_ORGS=
CHROME_PATH=
README_API_KEY=
README_BRANCH=stable
MIGRATION_PREVIEW_TIMEOUT_MIN=15
# Saved raw source of a migrated site (truth.json, llms.txt, robots.txt, sitemap.xml, html/, md/) for `npm run test:proof`; kept outside this repository
DAI_SOURCE_TRUTH_DIR=
